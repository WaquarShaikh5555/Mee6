<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Asking about a package requires declaring it since Android 11. Listing the
    six apps Regain knows about is narrower than QUERY_ALL_PACKAGES, which Play
    restricts — and Regain has no business enumerating anything else.
  -->
  <queries>
    <package android:name="com.instagram.android" />
    <package android:name="com.google.android.youtube" />
    <package android:name="com.snapchat.android" />
    <package android:name="com.zhiliaoapp.musically" />
    <package android:name="com.ss.android.ugc.trill" />
    <package android:name="com.discord" />
    <package android:name="com.twitter.android" />
  </queries>

  <application>
    <!--
      exported="true" is required for the system to bind the service; the
      BIND_ACCESSIBILITY_SERVICE permission is what stops anything else from
      doing so.
    -->
    <service
      android:name=".RegainAccessibilityService"
      android:exported="true"
      android:label="@string/regain_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/regain_service_config" />
    </service>
  </application>

</manifest>
