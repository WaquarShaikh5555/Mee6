# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# They are inlined at build time — never put a secret here.
#
# Copy to `.env` and restart the dev server with `npx expo start -c`.
# With no `.env` (or this variable empty) the app uses the on-device demo
# service and shows a "Preview build" badge.
#
# Local backend on your computer, phone on the same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8082
#
# Android emulator (10.0.2.2 is the host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8082
#
# Deployed backend (value printed by infra/deploy.sh):
# EXPO_PUBLIC_API_URL=https://<app>.azurecontainerapps.io
