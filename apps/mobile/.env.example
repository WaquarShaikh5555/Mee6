# Copy to `.env`, then restart the dev server with: npx expo start -c
#
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the app bundle at
# build time. Only ever put *publishable* values here.
#
# ---------------------------------------------------------------- Supabase ---
# Project Settings → API. The URL and the publishable/anon key are safe to ship
# in an app: every table is protected by row-level security, so the key grants
# nothing on its own.
#
# NEVER put the service_role / secret key here. It bypasses RLS entirely and
# would give anyone who extracts it full control of the database.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable or anon key>

# ------------------------------------------------- self-hosted API (optional) ---
# Only for a deployment that runs its own server (apps/api). When Supabase is
# configured above, this is ignored.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8082
#
# With neither set, the app uses the on-device demo service and shows a
# "Preview build" badge.
