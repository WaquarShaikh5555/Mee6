# Shaikh's API — example environment.
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is gitignored. Every value below has a working development default,
# so an empty `.env` also boots (embedded PGlite, console email).
#
# In production every secret comes from the App Service / Container Apps
# configuration (or Key Vault references) — never from a committed file.

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=8082
# Bind 0.0.0.0 so containers and the sandbox preview can reach the server.
HOST=0.0.0.0
LOG_LEVEL=info

# --------------------------------------------------------------- database ---
# Production: Azure Database for PostgreSQL Flexible Server.
#   postgres://USER:PASSWORD@HOST.postgres.database.azure.com:5432/shaikhs?sslmode=require
# Leave empty in development to use the embedded PostgreSQL 16 build (PGlite).
DATABASE_URL=
# PGlite data directory when DATABASE_URL is empty.
#   memory://   — wipes on restart (default; fine for throwaway runs)
#   .data/pg    — persists across restarts on your machine
PGLITE_PATH=memory://
DB_POOL_MAX=10

# ------------------------------------------------------------------- cors ---
# Comma-separated allowlist of browser origins. Empty = reflect any origin,
# which is development-only. Production must list real origins, e.g.
#   https://app.shaikhs.example,https://shaikhs.example
CORS_ORIGINS=

# ------------------------------------------------------------------- auth ---
SESSION_TTL_DAYS=30
RESET_TTL_MINUTES=60
# Required in production. Generate with: openssl rand -hex 32
# Mixed into stored IP hashes so they cannot be reversed with a rainbow table.
IP_HASH_PEPPER=dev-only-pepper-change-me
RATE_LIMIT_AUTH_PER_MINUTE=10
# Set to true behind a proxy/ingress (App Service, Container Apps) so client
# IPs come from X-Forwarded-For instead of the load balancer.
TRUST_PROXY=true

# ------------------------------------------------------------------ email ---
# console — reset links are printed to the log (development only)
# acs     — Azure Communication Services Email
EMAIL_TRANSPORT=console
# From the ACS resource: "Keys" → connection string.
ACS_CONNECTION_STRING=
# A verified sender, e.g. DoNotReply@<guid>.azurecomm.net or no-reply@yourdomain
ACS_SENDER_ADDRESS=
# Deep link used inside the reset email. The mobile app handles this scheme.
APP_PUBLIC_URL=shaikhs://reset-password
